# Public site URL — used for canonicals, sitemap, OG images
NEXT_PUBLIC_SITE_URL=https://decibyl.ai

# Supabase (server only — SERVICE ROLE KEY MUST NEVER BE PREFIXED NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# n8n lead webhook
N8N_LEAD_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Resend — waitlist confirmation email with the booking link
RESEND_API_KEY=
# Optional — defaults to "Decibyl <hello@decibyl.ai>". The domain in this
# address must be verified in Resend or sends will fail.
RESEND_FROM_EMAIL=
# Public embed token for the "Try us now" voice widget in the site footer.
#
# Required in production. Unset means the widget does not render at all — the
# page is fine, there is simply no microphone on it, and the build logs a
# warning.
#
# NOT a secret. It is handed to every visitor's browser by design and is
# readable in the page source. Keeping it out of the repository buys rotation
# without a deploy, not confidentiality.
#
# What actually protects it is domain scoping. In echowave-redesign,
# public_embed.validate_origin() returns True for EVERY origin when the token's
# allowed_domains list is empty, so an unscoped token works on anybody's site
# and bills us. Scope it to decibyl.ai and www.decibyl.ai in superadmin.
NEXT_PUBLIC_DECIBYL_WIDGET_TOKEN=
