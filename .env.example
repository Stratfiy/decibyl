# Public site URL — used for canonicals, sitemap, OG images
NEXT_PUBLIC_SITE_URL=https://decibyl.ai

# Supabase (server only — SERVICE ROLE KEY MUST NEVER BE PREFIXED NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# n8n lead webhook
N8N_LEAD_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Resend — waitlist confirmation email with the booking link
RESEND_API_KEY=
# Optional — defaults to "Decibyl <hello@decibyl.ai>". The domain in this
# address must be verified in Resend or sends will fail.
RESEND_FROM_EMAIL=
